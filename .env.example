# =============================================================
# Printy — Environment Variables Template
# Copy this file and fill in real values. Never commit real keys.
# =============================================================

# -------------------------------------------------------------
# FRONTEND (Vite — VITE_* prefix required, exposed to browser)
# Get from: Supabase Dashboard > capstone > Project Settings > API
# -------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Site URL used for Supabase auth redirects (email confirm, password reset)
# Local dev: http://localhost:5173
# Production: https://your-netlify-site.netlify.app
VITE_SITE_URL=http://localhost:5173


# -------------------------------------------------------------
# SERVER-SIDE ONLY (Netlify functions — never expose to browser)
# -------------------------------------------------------------

# Supabase service role key — bypasses RLS, for trusted server writes
# Get from: Supabase Dashboard > capstone > Project Settings > API > service_role
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Ollama — local LLM (no API key needed for local dev)
# Install: https://ollama.com — then: ollama pull llama3.1:8b
LLM_MODEL=llama3.1:8b
LLM_BASE_URL=http://localhost:11434

# Ollama — embeddings (nomic-embed-text produces 768-dim vectors)
# Pull: ollama pull nomic-embed-text
EMBED_MODEL=nomic-embed-text
EMBED_BASE_URL=http://localhost:11434


# -------------------------------------------------------------
# PRODUCTION ONLY (set in Netlify dashboard, not in any file)
# Listed here for documentation only.
# -------------------------------------------------------------
# VITE_SITE_URL=https://your-site.netlify.app
# LLM_BASE_URL=https://... (swap to a hosted model for prod if needed)
