{
  "name": "printy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:verbose": "vite --host --logLevel info",
    "build": "tsc -b && vite build",
    "type-check:functions": "tsc -p tsconfig.functions.json --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:staged": "git diff --name-only --cached --diff-filter=d -- '*.ts' '*.tsx' '*.js' '*.jsx' '*.json' '*.css' '*.md' | ForEach-Object { npx prettier --ignore-unknown --write -- $_ }",
    "format:unstaged": "git diff --name-only --diff-filter=d -- '*.ts' '*.tsx' '*.js' '*.jsx' '*.json' '*.css' '*.md' | ForEach-Object { npx prettier --ignore-unknown --write -- $_ }",
    "format:check": "prettier --check .",
    "ingest": "node --env-file=.env.local --experimental-strip-types scripts/ingest-knowledge.ts",
    "backup:run": "node --env-file=.env.backup --experimental-strip-types scripts/backup/backup.ts",
    "backup:restore": "node --env-file=.env.backup --experimental-strip-types scripts/backup/restore.ts",
    "backup:schedule": "node --env-file=.env.backup --experimental-strip-types scripts/backup/scheduler.ts",
    "archive:yearly": "node --env-file=.env.backup --experimental-strip-types scripts/archive/yearlyArchive.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@google/generative-ai": "^0.24.1",
    "@netlify/functions": "^5.1.0",
    "@radix-ui/react-progress": "^1.1.8",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/supabase-js": "^2.81.1",
    "clsx": "^2.1.1",
    "cohere-ai": "^8.0.0",
    "dotenv": "^17.2.3",
    "heic2any": "^0.0.4",
    "lucide-react": "^0.554.0",
    "node-cron": "^4.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.6",
    "tailwind-merge": "^3.4.0",
    "tslib": "^2.8.1",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.3.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.2"
  },
  "overrides": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
